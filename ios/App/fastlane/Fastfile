default_platform(:ios)

TEAM_ID = "AFU6P8WW9K"
APP_IDENTIFIER = "com.khg.oncallapp"

platform :ios do
  desc "Build and upload ON CALL to TestFlight without manual Xcode upload"
  lane :beta do
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].each do |name|
      UI.user_error!("Missing required #{name}") if ENV[name].to_s.strip.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    build_number = ENV["GITHUB_RUN_NUMBER"].to_s.strip
    build_number = Time.now.utc.strftime("%Y%m%d%H%M") if build_number.empty?

    increment_build_number(
      build_number: build_number,
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: "../ExportOptions.plist",
      clean: true,
      output_directory: "./build",
      output_name: "on-call.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID} -allowProvisioningUpdates",
      disable_package_automatic_updates: true,
      result_bundle: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Automated ON CALL production candidate")
    )

    UI.success("ON CALL uploaded to TestFlight")
  end
end
