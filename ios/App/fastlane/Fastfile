default_platform(:ios)

TEAM_ID = "AFU6P8WW9K"
APP_IDENTIFIER = "com.khg.oncallapp"

platform :ios do
  desc "Build and upload ON CALL to TestFlight without manual Xcode upload"
  lane :beta do
    %w[ASC_KEY_ID ASC_ISSUER_ID].each do |name|
      UI.user_error!("Missing required #{name}") if ENV[name].to_s.strip.empty?
    end
    key_path = ENV["ASC_KEY_PATH"].to_s.strip
    key_content = ENV["ASC_KEY_CONTENT"].to_s
    UI.user_error!("Missing ASC_KEY_PATH or ASC_KEY_CONTENT") if key_path.empty? && key_content.strip.empty?

    api_key_options = {
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      duration: 1200,
      in_house: false
    }
    if !key_path.empty?
      api_key_options[:key_filepath] = key_path
    else
      api_key_options[:key_content] = key_content
      api_key_options[:is_key_content_base64] = false
    end
    api_key = app_store_connect_api_key(**api_key_options)

    build_number = ENV["GITHUB_RUN_NUMBER"].to_s.strip
    build_number = Time.now.utc.strftime("%Y%m%d%H%M") if build_number.empty?
    increment_build_number(build_number: build_number, xcodeproj: "App.xcodeproj")

    signing_args = ["DEVELOPMENT_TEAM=#{TEAM_ID}", "-allowProvisioningUpdates"]
    unless key_path.empty?
      signing_args += [
        "-authenticationKeyPath '#{key_path}'",
        "-authenticationKeyID '#{ENV["ASC_KEY_ID"]}'",
        "-authenticationKeyIssuerID '#{ENV["ASC_ISSUER_ID"]}'"
      ]
    end

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: "../ExportOptions.plist",
      clean: true,
      output_directory: "./build",
      output_name: "on-call.ipa",
      xcargs: signing_args.join(" "),
      disable_package_automatic_updates: true,
      result_bundle: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Automated ON CALL production candidate")
    )

    UI.success("ON CALL uploaded to TestFlight")
  end
end
