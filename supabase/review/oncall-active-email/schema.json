      "table": "oc_application_service_matches",
      "definition": "CHECK ((match_method = ANY (ARRAY['exact_id'::text, 'exact_name'::text, 'manual'::text])))"
    },
    {
      "name": "oc_application_service_matches_pkey",
      "table": "oc_application_service_matches",
      "definition": "PRIMARY KEY (application_id, service_id)"
    },
    {
      "name": "oc_application_service_matches_service_id_fkey",
      "table": "oc_application_service_matches",
      "definition": "FOREIGN KEY (service_id) REFERENCES oc_service_catalog(id) ON DELETE CASCADE"
    },
    {
      "name": "oc_provider_verification_checks_application_id_fkey",
      "table": "oc_provider_verification_checks",
      "definition": "FOREIGN KEY (application_id) REFERENCES oc_provider_applications(id) ON DELETE CASCADE"
    },
    {
      "name": "oc_provider_verification_checks_check_type_check",
      "table": "oc_provider_verification_checks",
      "definition": "CHECK ((check_type = ANY (ARRAY['identity'::text, 'background'::text, 'license'::text, 'insurance'::text, 'skills'::text, 'service_area'::text, 'vehicle'::text])))"
    },
    {
      "name": "oc_provider_verification_checks_pkey",
      "table": "oc_provider_verification_checks",
      "definition": "PRIMARY KEY (application_id, check_type)"
    },
    {
      "name": "oc_provider_verification_checks_status_check",
      "table": "oc_provider_verification_checks",
      "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'submitted'::text, 'under_review'::text, 'passed'::text, 'failed'::text, 'waived'::text, 'expired'::text])))"
    },
    {
      "name": "marketplace_operator_alerts_pkey",
      "table": "marketplace_operator_alerts",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "marketplace_operator_alerts_product_key_check",
